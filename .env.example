CI_ENV=production
COMPOSE_PROFILES=openvscode

JOBSEEKER_HTTP_PORT=80
JOBSEEKER_DB_PORT=3306
JOBSEEKER_DB_USER=mysql
JOBSEEKER_DB_PASSWORD=mysql
JOBSEEKER_DB_NAME=jobseeker
JOBSEEKER_MYSQL_ROOT_PASSWORD=root
JOBSEEKER_ENCRYPTION_KEY=replace-with-a-long-random-secret
JOBSEEKER_COOKIE_SECURE=false

# The application always stores and computes time in UTC. This only sets which
# side of the UI timezone toggle a first-time viewer starts on: "UTC" (default)
# or any other PHP timezone identifier to start on local time. Viewers can flip
# it themselves and the choice is remembered per browser.
JOBSEEKER_TIMEZONE=UTC

# Screen operator-authored job commands (Linux shell, Windows batch, inline Python)
# for destructive / exfiltration patterns before they are compiled into a Jenkins job.
# false (default): JobSeeker warns in the job dependency panel but still creates the job.
# true: a critical/high finding refuses the save and blocks the inline Python preview.
# This is a defense-in-depth aid, not a sandbox - see doc/jobseeker/Security/command-hardening.md
# for the container controls that actually contain a hostile job.
JOBSEEKER_COMMAND_GUARD_ENFORCE=false
JOBSEEKER_HOST_UID=1000
JOBSEEKER_HOST_GID=1000

# VS Code-compatible browser IDE for inline Python workspaces.
# The compose service binds to localhost, mounts only ./repository, and includes Python tooling.
JOBSEEKER_OPENVSCODE_ENABLED=true
JOBSEEKER_OPENVSCODE_HOST=127.0.0.1
JOBSEEKER_OPENVSCODE_PORT=3000
JOBSEEKER_OPENVSCODE_PUBLIC_URL=
JOBSEEKER_OPENVSCODE_WORKSPACE=/home/workspace
JOBSEEKER_OPENVSCODE_TOKEN=jobseeker-local-vscode
# Stop OpenVSCode after this many minutes without a connected editor. Use 0 to disable.
JOBSEEKER_OPENVSCODE_IDLE_TIMEOUT_MINUTES=30
JOBSEEKER_DEFAULT_DOCKER_PYTHON_VERSION=3.13

# Authenticates Jenkins workers to the internal scoped connector endpoint.
JOBSEEKER_CONNECTOR_API_TOKEN=change-this-local-connector-token-before-shared-use
# Arbitrary connector secret variables belong in the ignored .env.connectors file.
# Use .env.connectors.example as the variable-name template.
# Optional Azure identity used only when an Azure Key Vault connector is materialized.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FEDERATED_TOKEN_FILE=
AZURE_AUTHORITY_HOST=
# Prefer an IAM role or web identity; static keys are supported by the default AWS chain.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ROLE_ARN=
AWS_WEB_IDENTITY_TOKEN_FILE=

JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_ID=jobseeker
JENKINS_ADMIN_PASSWORD=jobseeker

# Jenkins controller executors are real Jenkins worker slots on the main Jenkins container.
# They are not CPU reservations. The local template keeps one controller executor
# and expects DEV/QA agent workers to carry most local build concurrency.
JENKINS_NUM_EXECUTORS=1
JOBSEEKER_JENKINS_PUBLIC_URL=http://localhost:8080/

# JobSeeker environment slots are trigger gates before Jenkins starts builds.
# They are not CPU threads. DEV=2 means JobSeeker allows two DEV builds to be active/queued.
# Local development keeps DEV/QA active; add UAT/PROD when those agents are running.
JOBSEEKER_JENKINS_DEFAULT_ENVIRONMENT_SLOTS=1
JOBSEEKER_JENKINS_ENVIRONMENT_SLOTS=DEV=2,QA=1

# Optional per-environment Jenkins agent workers. Disabled by default so the local stack stays lightweight.
# Set JOBSEEKER_JENKINS_ENVIRONMENT_AGENTS_ENABLED=true and recreate php for JobSeeker-created/promoted jobs to be pinned to agent labels.
# Local 4-core start after enabling routing: docker compose --profile jenkins-agents up -d --build --force-recreate php jenkins-agent-dev jenkins-agent-qa
# Full environment start: docker compose --profile jenkins-agents up -d --build
JOBSEEKER_JENKINS_ENVIRONMENT_AGENTS_ENABLED=false
JOBSEEKER_JENKINS_ENVIRONMENT_AGENT_LABELS=DEV=jobseeker-env-dev,QA=jobseeker-env-qa,UAT=jobseeker-env-uat,PROD=jobseeker-env-prod
JOBSEEKER_JENKINS_AGENT_WEB_SOCKET=false
JOBSEEKER_JENKINS_AGENT_TUNNEL=jenkins:50000

# Per-agent Jenkins executors are the max parallel builds inside each agent container.
# They are not CPU reservations; keep them at or below the CPU capacity you intend to give that container/VM.
JOBSEEKER_JENKINS_DEV_AGENT_EXECUTORS=2
JOBSEEKER_JENKINS_QA_AGENT_EXECUTORS=1
JOBSEEKER_JENKINS_UAT_AGENT_EXECUTORS=1
JOBSEEKER_JENKINS_PROD_AGENT_EXECUTORS=1
