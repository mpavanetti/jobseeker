CI_ENV=production
COMPOSE_PROFILES=openvscode

# Deployment topology. "multi" is the default and keeps all environments in
# one control plane. For one installation per environment, keep this file at
# multi and start with docker-compose.standalone.yml; that override sets
# standalone and requires JOBSEEKER_STANDALONE_ENVIRONMENT.
JOBSEEKER_DEPLOYMENT_MODE=multi
JOBSEEKER_STANDALONE_ENVIRONMENT=
JOBSEEKER_STANDALONE_EXECUTORS=2

JOBSEEKER_HTTP_PORT=80
JOBSEEKER_DB_PORT=3306
JOBSEEKER_DB_USER=mysql
JOBSEEKER_DB_PASSWORD=mysql
JOBSEEKER_DB_NAME=jobseeker
JOBSEEKER_MYSQL_ROOT_PASSWORD=root
JOBSEEKER_ENCRYPTION_KEY=replace-with-a-long-random-secret
JOBSEEKER_COOKIE_SECURE=false

# Sign-in brute-force throttle (tbl_login_attempts). A sliding window: once an
# email address accumulates MAX_ATTEMPTS failed sign-ins - or a single client IP
# accumulates MAX_ATTEMPTS_PER_IP - within LOCKOUT_MINUTES, further attempts are
# refused until the window rolls forward. A successful sign-in clears that
# address. Defaults shown.
JOBSEEKER_LOGIN_MAX_ATTEMPTS=5
JOBSEEKER_LOGIN_MAX_ATTEMPTS_PER_IP=50
JOBSEEKER_LOGIN_LOCKOUT_MINUTES=15

# The application always stores and computes time in UTC. This only sets which
# side of the UI timezone toggle a first-time viewer starts on: "UTC" (default)
# or any other PHP timezone identifier to start on local time. Viewers can flip
# it themselves and the choice is remembered per browser.
JOBSEEKER_TIMEZONE=UTC

# Screen operator-authored job commands (Linux shell, Windows batch, inline Python)
# for destructive / exfiltration patterns before they are compiled into a Jenkins job.
# false (default): JobSeeker warns in the job dependency panel but still creates the job.
# true: a critical/high finding refuses the save and blocks the inline Python preview.
# This is a defense-in-depth aid, not a sandbox - see doc/jobseeker/Security/command-hardening.md
# for the container controls that actually contain a hostile job.
JOBSEEKER_COMMAND_GUARD_ENFORCE=false

# Pre-flight environment-slot gate. Off by default: JobSeeker sends every trigger
# to Jenkins and lets Jenkins' own queue hold builds until an executor is free -
# that is what Jenkins does well, and the extra gate only produced a confusing
# 429. The per-environment slot figures are still shown (read-only) on the
# dashboard capacity card. Set to true only if you want JobSeeker to hard-refuse
# a trigger (HTTP 429) once an environment reaches its configured slot count.
JOBSEEKER_JENKINS_SLOT_GATE_ENFORCE=false
JOBSEEKER_HOST_UID=1000
JOBSEEKER_HOST_GID=1000

# VS Code-compatible browser IDE for inline Python workspaces.
# The compose service binds to localhost, mounts only ./repository, and includes Python tooling.
JOBSEEKER_OPENVSCODE_ENABLED=true
JOBSEEKER_OPENVSCODE_HOST=127.0.0.1
JOBSEEKER_OPENVSCODE_PORT=3000
JOBSEEKER_OPENVSCODE_PUBLIC_URL=
JOBSEEKER_OPENVSCODE_WORKSPACE=/home/workspace
JOBSEEKER_OPENVSCODE_TOKEN=jobseeker-local-vscode
# Stop OpenVSCode after this many minutes without a connected editor. Use 0 to disable.
JOBSEEKER_OPENVSCODE_IDLE_TIMEOUT_MINUTES=30
# Optional open-source coding assistant inside OpenVSCode. Enabling this build
# switch installs Continue; the Ollama service and model downloads stay opt-in.
JOBSEEKER_OPENVSCODE_CONTINUE_ENABLED=false
JOBSEEKER_OLLAMA_HOST=127.0.0.1
JOBSEEKER_OLLAMA_PORT=11434
JOBSEEKER_DEFAULT_DOCKER_PYTHON_VERSION=3.13

# Bound browser-rendered TMF result pages. Narrow filters remain available for
# older rows, and the server caps this value at 10,000 to protect PHP memory.
JOBSEEKER_TMF_RESULT_LIMIT=1000

# Authenticates Jenkins workers to the internal scoped connector endpoint.
JOBSEEKER_CONNECTOR_API_TOKEN=change-this-local-connector-token-before-shared-use
# Arbitrary connector secret variables belong in the ignored .env.connectors file.
# Use .env.connectors.example as the variable-name template.
# Optional Azure identity used only when an Azure Key Vault connector is materialized.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FEDERATED_TOKEN_FILE=
AZURE_AUTHORITY_HOST=
# Prefer an IAM role or web identity; static keys are supported by the default AWS chain.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ROLE_ARN=
AWS_WEB_IDENTITY_TOKEN_FILE=

JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_ID=jobseeker
JENKINS_ADMIN_PASSWORD=jobseeker

# Jenkins controller executors are real Jenkins worker slots on the main Jenkins container.
# They are not CPU reservations. The local template keeps one controller executor
# and expects DEV/QA agent workers to carry most local build concurrency.
JENKINS_NUM_EXECUTORS=1
JOBSEEKER_JENKINS_PUBLIC_URL=http://localhost:8080/

# JobSeeker environment slots are trigger gates before Jenkins starts builds.
# They are not CPU threads. DEV=2 means JobSeeker allows two DEV builds to be active/queued.
# Local development keeps DEV/QA active; add UAT/PROD when those agents are running.
JOBSEEKER_JENKINS_DEFAULT_ENVIRONMENT_SLOTS=1
JOBSEEKER_JENKINS_ENVIRONMENT_SLOTS=DEV=2,QA=1

# Optional per-environment Jenkins agent workers. Disabled by default so the local stack stays lightweight.
# Set JOBSEEKER_JENKINS_ENVIRONMENT_AGENTS_ENABLED=true and recreate php for JobSeeker-created/promoted jobs to be pinned to agent labels.
# Local 4-core start after enabling routing: docker compose --profile jenkins-agents up -d --build --force-recreate php jenkins-agent-dev jenkins-agent-qa
# Full environment start: docker compose --profile jenkins-agents up -d --build
JOBSEEKER_JENKINS_ENVIRONMENT_AGENTS_ENABLED=false
JOBSEEKER_JENKINS_ENVIRONMENT_AGENT_LABELS=DEV=jobseeker-env-dev,QA=jobseeker-env-qa,UAT=jobseeker-env-uat,PROD=jobseeker-env-prod
JOBSEEKER_JENKINS_AGENT_WEB_SOCKET=false
JOBSEEKER_JENKINS_AGENT_TUNNEL=jenkins:50000

# Per-agent Jenkins executors are the max parallel builds inside each agent container.
# They are not CPU reservations; keep them at or below the CPU capacity you intend to give that container/VM.
JOBSEEKER_JENKINS_DEV_AGENT_EXECUTORS=2
JOBSEEKER_JENKINS_QA_AGENT_EXECUTORS=1
JOBSEEKER_JENKINS_UAT_AGENT_EXECUTORS=1
JOBSEEKER_JENKINS_PROD_AGENT_EXECUTORS=1

# --- Apache Hop -------------------------------------------------------------
# Jenkins stays the scheduler and trigger for Hop jobs; these settings only
# describe how and where a Hop workflow or pipeline is executed.
JOBSEEKER_HOP_ENABLED=true
JOBSEEKER_HOP_VERSION=2.19.0

# Image used by the "container" engine, one ephemeral run per build. The default
# is the public apache/hop image, which ships no MySQL, MariaDB or Oracle JDBC
# driver, so a connector-backed job installs the one it needs on container start
# (about a minute per build). To remove that cost, build the JobSeeker image,
# copy it into the daemon Jenkins jobs use, and name it here:
#   docker compose --profile hop build hop-server
#   ./scripts/load-hop-image.sh
#   JOBSEEKER_HOP_IMAGE=jobseeker-hop:local
JOBSEEKER_HOP_IMAGE=
# JDBC drivers baked into the JobSeeker Hop image. Run `hop driver list` for ids.
JOBSEEKER_HOP_DRIVERS=mysql,mariadb
# Optional Maven mirror for driver downloads on an air-gapped network.
JOBSEEKER_HOP_DRIVERS_MAVEN_REPO=
# Per-run container limits when a job does not set its own.
JOBSEEKER_HOP_CPU_LIMIT=1
JOBSEEKER_HOP_MEMORY_LIMIT_MB=1024
# Docker network for the run container. "host" lets it reach the platform
# services the way the Python and shell Docker runtimes already do.
JOBSEEKER_HOP_NETWORK=host

# Optional long-lived Hop Server, the "server" engine: a warm JVM that starts a
# run in well under a second instead of tens of seconds. Start it with
# `docker compose --profile hop up -d hop-server`. It is shared, so JobSeeker
# serializes server runs; use the container engine for parallel or isolated work.
# It doubles as the publish target for the Apache Hop GUI: point a Hop Server
# metadata object at this address and JobSeeker picks up whatever you run.
JOBSEEKER_HOP_SERVER_HOST=127.0.0.1
JOBSEEKER_HOP_SERVER_PORT=8181
JOBSEEKER_HOP_SERVER_USER=cluster
JOBSEEKER_HOP_SERVER_PASSWORD=cluster
JOBSEEKER_HOP_SERVER_ENVIRONMENT=DEV
# Optional persistent connector catalog for Hop API clients that do not run
# through JobSeeker. JobSeeker jobs build an ephemeral catalog per run, so this
# is off by default to avoid keeping resolved credentials on disk.
JOBSEEKER_HOP_CONNECTOR_REFRESH=false
JOBSEEKER_HOP_SERVER_JAVA_OPTIONS=-Xms256m -Xmx1024m
# Where the Hop Server keeps its own configuration. It lives on the repository
# volume so JobSeeker can publish platform variables into it for pipelines
# started from the Apache Hop GUI; the container seeds it from the image on
# first start. Hop reads those variables when it starts, so republishing them
# needs `docker compose --profile hop restart hop-server`.
JOBSEEKER_HOP_SERVER_CONFIG_FOLDER=/php/repository/hop/server/config
# Where the Hop Server writes the zip the Apache Hop GUI uploads when it
# publishes a run. Keeping it on the repository volume is what lets the Apache
# Hop screen import such a run into a real project so it can become a Jenkins
# job; it is the Hop Server's JVM temp folder, so do not point it outside the
# repository.
JOBSEEKER_HOP_SERVER_EXPORT_FOLDER=/php/repository/hop/server/exports
# Where the Hop Server installs the JDBC drivers its published connections need.
# The image bundles only the permissively licensed drivers (PostgreSQL, SQL
# Server including Azure SQL); MySQL, MariaDB and Oracle are installed on demand.
# Keeping this on the repository volume means the download happens once rather
# than on every container rebuild.
JOBSEEKER_HOP_SERVER_JDBC_FOLDER=/php/repository/hop/server/jdbc
# The Apache Hop screen reconciles the Hop Server into JobSeeker while it is
# open, so a pipeline or workflow published to the server straight from the
# Apache Hop GUI still gets a Transaction Monitoring row. This is how many of
# those runs the screen keeps on show.
JOBSEEKER_HOP_EXECUTION_HISTORY=100
