# Optional worker-side values referenced by Connectors > Environment variables.
# The real .env.connectors file is ignored by Git and loaded only by Jenkins workers.
# Map these names to connector fields in the UI; do not use JOBSEEKER_CONNECTOR_* names here.
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=
VENDOR_API_KEY=
AZURE_STORAGE_SAS_TOKEN=
SFTP_PRIVATE_KEY=
