<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>main</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Resolves JobSeeker scope, copies one Data Asset to another, and propagates failures to Jenkins and TMF.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/01/01 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/01/01 00:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name><description/><type>SPECIAL</type><attributes/>
      <DayOfMonth>1</DayOfMonth><hour>12</hour><intervalMinutes>60</intervalMinutes><intervalSeconds>0</intervalSeconds><minutes>0</minutes><repeat>N</repeat><schedulerType>0</schedulerType><weekDay>1</weekDay>
      <parallel>N</parallel><xloc>48</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>show resolved scope</name><description/><type>PIPELINE</type><attributes/>
      <add_date>N</add_date><add_time>N</add_time><clear_files>N</clear_files><clear_rows>N</clear_rows><create_parent_folder>N</create_parent_folder><exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/show-contexts.hpl</filename><logext/><logfile/><loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters><params_from_previous>N</params_from_previous><run_configuration>local</run_configuration><set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>240</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>copy Data Assets</name><description/><type>PIPELINE</type><attributes/>
      <add_date>N</add_date><add_time>N</add_time><clear_files>N</clear_files><clear_rows>N</clear_rows><create_parent_folder>N</create_parent_folder><exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/copy-data-assets.hpl</filename><logext/><logfile/><loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters><params_from_previous>N</params_from_previous><run_configuration>local</run_configuration><set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>464</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action><name>Success</name><description/><type>SUCCESS</type><attributes/><parallel>N</parallel><xloc>688</xloc><yloc>96</yloc><attributes_hac/></action>
    <action><name>Abort</name><description/><type>ABORT</type><attributes/><message>The Data Asset and Context sample failed. Check that both assets and every required Context Detail exist in the selected environment.</message><parallel>N</parallel><xloc>464</xloc><yloc>224</yloc><attributes_hac/></action>
  </actions>
  <hops>
    <hop><from>Start</from><to>show resolved scope</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>show resolved scope</from><to>copy Data Assets</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>show resolved scope</from><to>Abort</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>copy Data Assets</from><to>Success</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>copy Data Assets</from><to>Abort</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>
