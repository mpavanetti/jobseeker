<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>copy-data-assets</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads and writes CSV files exclusively through JobSeeker Data Asset variables.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/01/01 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/01/01 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>read input Data Asset</from><to>write output Data Asset</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>read input Data Asset</name>
    <type>CSVInput</type>
    <description>The host or container path is resolved by JobSeeker for this execution engine.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${JOBSEEKER_ASSET_HOP_CUSTOMER_INPUT}</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>customer_id</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>name</name><type>String</type><format/><currency/><decimal/><group/><length>255</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>128</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>write output Data Asset</name>
    <type>TextFileOutput</type>
    <description>The output path is owned by the JobSeeker Data Asset catalog.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${JOBSEEKER_ASSET_HOP_CUSTOMER_OUTPUT}</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention/>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field><name>customer_id</name><type>Integer</type><format>0</format><currency/><decimal>.</decimal><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>0</precision></field>
      <field><name>name</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>255</length><precision>-1</precision></field>
    </fields>
    <attributes/>
    <GUI><xloc>400</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
