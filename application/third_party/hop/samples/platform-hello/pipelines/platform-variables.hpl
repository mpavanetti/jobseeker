<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>platform-variables</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads the variables JobSeeker publishes into every Hop run and writes them to the Jenkins console.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/01/01 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/01/01 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>read JobSeeker variables</from>
      <to>write runtime context to log</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>write runtime context to log</from>
      <to>read a Data Asset variable</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>read a Data Asset variable</from>
      <to>write Data Asset path to log</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read JobSeeker variables</name>
    <type>GetVariable</type>
    <description>JobSeeker writes these into the run's Hop environment config file.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>environment</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${JOBSEEKER_ENVIRONMENT}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>job_name</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${JOBSEEKER_JOB_NAME}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>tmf_instance_id</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${JOBSEEKER_TMF_INSTANCE_ID}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>build_number</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${JOBSEEKER_BUILD_NUMBER}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>custom_context</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${Custom}</variable>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>write runtime context to log</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>JobSeeker runtime context. The TMF instance id below is the row this run opened in Transaction Monitoring.</logmessage>
    <fields>
      <field>
        <name>environment</name>
      </field>
      <field>
        <name>job_name</name>
      </field>
      <field>
        <name>tmf_instance_id</name>
      </field>
      <field>
        <name>build_number</name>
      </field>
      <field>
        <name>custom_context</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>read a Data Asset variable</name>
    <type>GetVariable</type>
    <description>Every Data Asset in scope is published as JOBSEEKER_ASSET_&lt;KEY&gt;.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>customer_reference_path</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${JOBSEEKER_ASSET_CUSTOMER_REFERENCE}</variable>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>write Data Asset path to log</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>Data Asset lookup. A resolved path appears once an asset with the key customer-reference is registered in Extract Transform Load &gt; Data Assets for this environment; otherwise the optional value is blank.</logmessage>
    <fields>
      <field>
        <name>customer_reference_path</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
