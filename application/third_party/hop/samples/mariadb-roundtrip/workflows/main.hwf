<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>main</name><name_sync_with_filename>Y</name_sync_with_filename>
  <description>Creates an isolated table, writes and reads one run-scoped row through the JobSeeker connector, then removes the row.</description><extended_description/><workflow_version/>
  <created_user>-</created_user><created_date>2026/01/01 00:00:00.000</created_date><modified_user>-</modified_user><modified_date>2026/01/01 00:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action><name>Start</name><description/><type>SPECIAL</type><attributes/><DayOfMonth>1</DayOfMonth><hour>12</hour><intervalMinutes>60</intervalMinutes><intervalSeconds>0</intervalSeconds><minutes>0</minutes><repeat>N</repeat><schedulerType>0</schedulerType><weekDay>1</weekDay><parallel>N</parallel><xloc>48</xloc><yloc>96</yloc><attributes_hac/></action>
    <action>
      <name>prepare isolated table</name><description>The table belongs only to this example.</description><type>SQL</type><attributes/>
      <connection>jobseeker-mariadb</connection>
      <sql>CREATE TABLE IF NOT EXISTS jobseeker_hop_sample_rows (
  run_id VARCHAR(64) NOT NULL,
  environment VARCHAR(64) NOT NULL,
  job_name VARCHAR(255) NOT NULL,
  context_value VARCHAR(1000) NULL,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (run_id)
)</sql>
      <useVariableSubstitution>N</useVariableSubstitution><sqlfromfile>N</sqlfromfile><sqlfilename/><sqlfilename_encoding/><sendOneStatement>Y</sendOneStatement>
      <parallel>N</parallel><xloc>240</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>write sample row</name><description/><type>PIPELINE</type><attributes/><add_date>N</add_date><add_time>N</add_time><clear_files>N</clear_files><clear_rows>N</clear_rows><create_parent_folder>N</create_parent_folder><exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/write-sample-row.hpl</filename><logext/><logfile/><loglevel>Basic</loglevel><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><params_from_previous>N</params_from_previous><run_configuration>local</run_configuration><set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><parallel>N</parallel><xloc>464</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>read sample row</name><description/><type>PIPELINE</type><attributes/><add_date>N</add_date><add_time>N</add_time><clear_files>N</clear_files><clear_rows>N</clear_rows><create_parent_folder>N</create_parent_folder><exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/read-sample-row.hpl</filename><logext/><logfile/><loglevel>Basic</loglevel><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><params_from_previous>N</params_from_previous><run_configuration>local</run_configuration><set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><parallel>N</parallel><xloc>688</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>remove sample row</name><description>Retains the empty sample table but removes this run's data.</description><type>SQL</type><attributes/>
      <connection>jobseeker-mariadb</connection><sql>DELETE FROM jobseeker_hop_sample_rows WHERE run_id = '${JOBSEEKER_TMF_INSTANCE_ID}'</sql><useVariableSubstitution>Y</useVariableSubstitution><sqlfromfile>N</sqlfromfile><sqlfilename/><sqlfilename_encoding/><sendOneStatement>Y</sendOneStatement>
      <parallel>N</parallel><xloc>912</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action><name>Success</name><description/><type>SUCCESS</type><attributes/><parallel>N</parallel><xloc>1136</xloc><yloc>96</yloc><attributes_hac/></action>
    <action><name>Abort</name><description/><type>ABORT</type><attributes/><message>The MariaDB round-trip failed. Confirm that jobseeker-mariadb is enabled for this environment/job and can create/select/insert/delete in its database.</message><parallel>N</parallel><xloc>688</xloc><yloc>240</yloc><attributes_hac/></action>
  </actions>
  <hops>
    <hop><from>Start</from><to>prepare isolated table</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>prepare isolated table</from><to>write sample row</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>prepare isolated table</from><to>Abort</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>write sample row</from><to>read sample row</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>write sample row</from><to>Abort</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>read sample row</from><to>remove sample row</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>read sample row</from><to>Abort</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>remove sample row</from><to>Success</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>remove sample row</from><to>Abort</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads>
  </notepads><attributes/>
</workflow>
