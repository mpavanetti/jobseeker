<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>read-sample-row</name><name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads back only the row written for the current TMF instance.</description><extended_description/><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user><created_date>2026/01/01 00:00:00.000</created_date><modified_user>-</modified_user><modified_date>2026/01/01 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order><hop><from>read isolated sample row</from><to>write round-trip result to log</to><enabled>Y</enabled></hop></order>
  <transform>
    <name>read isolated sample row</name><type>TableInput</type><description>The platform-generated TMF id scopes the query to this run.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <connection>jobseeker-mariadb</connection>
    <sql>SELECT run_id, environment, job_name, context_value FROM jobseeker_hop_sample_rows WHERE run_id = '${JOBSEEKER_TMF_INSTANCE_ID}'</sql>
    <limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><attributes/><GUI><xloc>128</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform>
    <name>write round-trip result to log</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>MariaDB round-trip succeeded through the JobSeeker connector.</logmessage>
    <fields><field><name>run_id</name></field><field><name>environment</name></field><field><name>job_name</name></field><field><name>context_value</name></field></fields>
    <attributes/><GUI><xloc>432</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling><attributes/>
</pipeline>
