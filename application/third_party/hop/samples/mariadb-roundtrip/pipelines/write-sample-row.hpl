<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>write-sample-row</name><name_sync_with_filename>Y</name_sync_with_filename>
    <description>Writes one run-scoped row through the JobSeeker-provided MariaDB connection.</description><extended_description/><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user><created_date>2026/01/01 00:00:00.000</created_date><modified_user>-</modified_user><modified_date>2026/01/01 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order><hop><from>read scoped values</from><to>write isolated sample row</to><enabled>Y</enabled></hop></order>
  <transform>
    <name>read scoped values</name><type>GetVariable</type><description>Values are injected by JobSeeker for this build.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><length>64</length><name>run_id</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${JOBSEEKER_TMF_INSTANCE_ID}</variable></field>
      <field><length>64</length><name>environment</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${JOBSEEKER_ENVIRONMENT}</variable></field>
      <field><length>255</length><name>job_name</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${JOBSEEKER_JOB_NAME}</variable></field>
      <field><length>1000</length><name>context_value</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${Custom}</variable></field>
    </fields><attributes/><GUI><xloc>128</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform>
    <name>write isolated sample row</name><type>TableOutput</type><description>Only the dedicated sample table is modified.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <commit>1</commit><connection>jobseeker-mariadb</connection><fields>
    </fields><ignore_errors>N</ignore_errors><partitioning_daily>N</partitioning_daily><partitioning_enabled>N</partitioning_enabled><partitioning_monthly>N</partitioning_monthly><return_keys>N</return_keys><specify_fields>N</specify_fields><table>jobseeker_hop_sample_rows</table><tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table><truncate>N</truncate><use_batch>N</use_batch>
    <attributes/><GUI><xloc>400</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling><attributes/>
</pipeline>
