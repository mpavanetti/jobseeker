<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>tmf-inventory</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads Transaction Monitoring history through the jobseeker-mariadb connector. The Hop database connection of that name is generated for the run from the JobSeeker connector registry, so no credential is stored in this file.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/01/01 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/01/01 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>read TMF status counts</from>
      <to>write inventory to log</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read TMF status counts</name>
    <type>TableInput</type>
    <description>The connection name is the JobSeeker connector key.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>jobseeker-mariadb</connection>
    <sql>SELECT status, COUNT(*) AS executions FROM tmf GROUP BY status ORDER BY executions DESC</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>write inventory to log</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>Y</limitRows>
    <limitRowsNumber>50</limitRowsNumber>
    <logmessage>Transaction Monitoring inventory for ${JOBSEEKER_ENVIRONMENT}, read through the jobseeker-mariadb connector.</logmessage>
    <fields>
      <field>
        <name>status</name>
      </field>
      <field>
        <name>executions</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
