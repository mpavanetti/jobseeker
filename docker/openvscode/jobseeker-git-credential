#!/bin/sh
# Git credential helper for workspaces JobSeeker opens: answers "get" with the
# personal Git account of the JobSeeker user who opened the workspace, fetched
# per request with the workspace's signed session (.git/jobseeker-git-session).
# Nothing is stored, so "store" and "erase" do nothing.
[ "${1:-}" = get ] || exit 0

host=
path=
protocol=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
    protocol=*) protocol=${line#protocol=} ;;
  esac
done

session="$(git rev-parse --git-dir 2>/dev/null)/jobseeker-git-session"
[ -n "$host" ] && [ -r "$session" ] || exit 0

curl -fsS -X POST -H "Authorization: Bearer $(cat "$session")" --data-urlencode "host=$host" \
  --data-urlencode "path=$path" --data-urlencode "protocol=$protocol" \
  "${JOBSEEKER_GIT_CREDENTIAL_URL:-http://nginx:8080/git-credential}" 2>/dev/null \
  || echo "JobSeeker: add a matching $host account on your JobSeeker profile, or reopen the workspace if its session is invalid." >&2
