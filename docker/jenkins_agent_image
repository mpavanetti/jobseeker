FROM docker:27-cli AS docker-cli

FROM jenkins/inbound-agent:latest-jdk21

USER root

RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3-pip python3-venv curl ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY application/third_party/python/jobseeker_sdk /opt/jobseeker/jobseeker_sdk/
COPY docker/jenkins/requirements.txt /opt/jobseeker/
RUN python3 -m pip install --no-cache-dir --break-system-packages /opt/jobseeker/jobseeker_sdk \
	&& python3 -m pip install --no-cache-dir --break-system-packages -r /opt/jobseeker/requirements.txt

COPY docker/jenkins/agent-entrypoint.sh /usr/local/bin/jobseeker-agent-entrypoint
RUN chmod +x /usr/local/bin/jobseeker-agent-entrypoint

USER jenkins
ENTRYPOINT ["/usr/local/bin/jobseeker-agent-entrypoint"]
