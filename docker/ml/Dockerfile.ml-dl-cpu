# JobSeeker ML runtime - CPU deep learning (PyTorch + Lightning).
# Built as jobseeker/ml-runtime:dl-cpu by scripts/build-ml-runtimes.sh.
FROM continuumio/miniconda3:24.9.2-0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    PIP_NO_CACHE_DIR=1

RUN conda install -y -c conda-forge \
        python=3.11 numpy pandas scikit-learn pyarrow matplotlib joblib \
    && conda clean -afy \
    && pip install --no-cache-dir \
        "torch==2.3.1+cpu" --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir lightning torchvision

COPY sdk /opt/jobseeker-ml-sdk
RUN pip install --no-deps /opt/jobseeker-ml-sdk

WORKDIR /workspace
RUN useradd -m -u 10001 mljob && chown -R mljob /workspace
USER mljob

ENTRYPOINT ["python", "-u"]
