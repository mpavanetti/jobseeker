#!/bin/sh
# Clone or inspect a Git repository with a materialized JobSeeker connector.
# Secrets are consumed through GIT_ASKPASS or an ephemeral SSH directory and
# are never placed in the repository URL, process arguments, or console output.
set -eu

usage() {
  echo "Usage: jobseeker-git {clone|ls-remote|heads} --connector-dir DIR [--branch REF] [--full] [--sparse PATH]... -- URL [TARGET]" >&2
  echo "       jobseeker-git push --connector-dir DIR -- URL WORKTREE REFSPEC..." >&2
  echo "       jobseeker-git features" >&2
  exit 2
}

command_name=${1:-}
case "$command_name" in
  clone|ls-remote|heads|push) ;;
  # Builds generated for newer helpers ask before using an option, so a
  # worker image that predates it keeps building with a full clone.
  features) echo sparse; exit 0 ;;
  *) usage ;;
esac
shift

connector_dir=
branch=
# Folders of a sparse clone. A job that lives in one folder of a repository
# holding many jobs fetches only its own folder (and the shared code).
sparse_paths=
# A shallow single-branch clone is enough for a build; an OpenVSCode working
# copy needs every branch and its history.
clone_depth="--depth 1"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --connector-dir)
      [ "$#" -ge 2 ] || usage
      connector_dir=$2
      shift 2
      ;;
    --branch)
      [ "$#" -ge 2 ] || usage
      branch=$2
      shift 2
      ;;
    --full)
      clone_depth=
      shift
      ;;
    --sparse)
      [ "$#" -ge 2 ] || usage
      case "$2" in
        ''|-*|/*|*..*|*[!A-Za-z0-9._/-]*) echo "Sparse paths are relative folder names." >&2; exit 2 ;;
      esac
      sparse_paths="$sparse_paths $2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *) usage ;;
  esac
done

[ -n "$connector_dir" ] || { echo "A Git credential connector directory is required." >&2; exit 2; }
[ -d "$connector_dir" ] || { echo "The selected Git credential connector is not available to this job." >&2; exit 78; }
[ "$#" -ge 1 ] || usage
repository_url=$1
shift

if [ "$command_name" = "clone" ]; then
  [ "$#" -eq 1 ] || usage
  target=$1
elif [ "$command_name" = "push" ]; then
  # A worktree and at least one refspec; refspecs never carry credentials.
  [ "$#" -ge 2 ] || usage
  worktree=$1
  shift
  [ -d "$worktree/.git" ] || { echo "The push worktree is not a Git working copy." >&2; exit 2; }
else
  [ "$#" -eq 0 ] || usage
fi

case "$repository_url" in
  http://*|https://*)
    transport=http
    authority=${repository_url#*://}
    authority=${authority%%/*}
    case "$authority" in *@*) echo "Git repository URLs must not contain credentials." >&2; exit 2;; esac
    url_host=${authority%%:*}
    ;;
  ssh://*)
    transport=ssh
    authority=${repository_url#ssh://}
    authority=${authority%%/*}
    url_host=${authority##*@}
    url_host=${url_host%%:*}
    ;;
  *@*:* )
    transport=ssh
    authority=${repository_url%%:*}
    url_host=${authority##*@}
    ;;
  *)
    echo "Only HTTP(S) and SSH Git repository URLs are supported." >&2
    exit 2
    ;;
esac

connector_host=
[ ! -f "$connector_dir/host" ] || connector_host=$(tr '[:upper:]' '[:lower:]' < "$connector_dir/host" | tr -d '[:space:]')
url_host=$(printf '%s' "$url_host" | tr '[:upper:]' '[:lower:]' | tr -d '[]')
[ -n "$connector_host" ] || { echo "The Git credential connector must declare its provider host." >&2; exit 78; }
[ "$url_host" = "$connector_host" ] || {
  echo "The selected Git credential is scoped to $connector_host, not $url_host." >&2
  exit 78
}

auth_type=none
[ ! -f "$connector_dir/auth_type" ] || auth_type=$(tr '[:upper:]' '[:lower:]' < "$connector_dir/auth_type" | tr -d '[:space:]')
temporary_dir=$(mktemp -d "/tmp/jobseeker-git.XXXXXX")
chmod 700 "$temporary_dir"
cleanup() {
  rm -rf "$temporary_dir"
}
trap cleanup EXIT HUP INT TERM

export GIT_TERMINAL_PROMPT=0

case "$auth_type" in
  token|api_key|username_password)
    [ "$transport" = "http" ] || {
      echo "Token and username/password Git connectors require an HTTP(S) repository URL." >&2
      exit 78
    }
    username_file="$connector_dir/username"
    password_file="$connector_dir/password"
    # A token without a username signs in with the provider's token user:
    # Bitbucket repository/workspace access tokens need x-token-auth (a
    # personal API token needs the account's username set on the connector).
    case "$url_host" in
      bitbucket.org) token_username=x-token-auth ;;
      gitlab.com) token_username=oauth2 ;;
      *) token_username=x-access-token ;;
    esac
    if [ "$auth_type" = "token" ] || [ "$auth_type" = "api_key" ]; then
      [ -f "$connector_dir/$auth_type" ] && password_file="$connector_dir/$auth_type"
      [ -f "$connector_dir/username" ] || {
        username_file="$temporary_dir/username"
        printf '%s' "$token_username" > "$username_file"
        chmod 600 "$username_file"
      }
    fi
    [ -f "$username_file" ] && [ -f "$password_file" ] || {
      echo "The selected Git connector is missing its username or token/password." >&2
      exit 78
    }
    askpass="$temporary_dir/askpass"
    cat > "$askpass" <<'EOF'
#!/bin/sh
case "${1:-}" in
  *sername*) cat "$JOBSEEKER_GIT_USERNAME_FILE" ;;
  *) cat "$JOBSEEKER_GIT_PASSWORD_FILE" ;;
esac
EOF
    chmod 700 "$askpass"
    export JOBSEEKER_GIT_USERNAME_FILE=$username_file
    export JOBSEEKER_GIT_PASSWORD_FILE=$password_file
    export GIT_ASKPASS=$askpass
    ;;
  ssh_key)
    # A deploy key reaches an https://host/owner/repo URL as git@host:owner/repo.
    if [ "$transport" = "http" ]; then
      repository_path=${repository_url#*://}
      repository_url="git@$url_host:${repository_path#*/}"
      transport=ssh
    fi
    key_file="$connector_dir/private_key"
    [ -f "$key_file" ] || key_file="$connector_dir/ssh_key"
    [ -f "$key_file" ] || { echo "The selected Git connector has no SSH private key." >&2; exit 78; }
    [ -f "$connector_dir/known_hosts" ] || {
      echo "SSH Git connectors require a pinned known_hosts value." >&2
      exit 78
    }
    cp "$key_file" "$temporary_dir/private_key"
    cp "$connector_dir/known_hosts" "$temporary_dir/known_hosts"
    chmod 600 "$temporary_dir/private_key" "$temporary_dir/known_hosts"
    export GIT_SSH_COMMAND="ssh -F /dev/null -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$temporary_dir/known_hosts -i $temporary_dir/private_key"
    ;;
  none) ;;
  *) echo "Unsupported Git connector authentication type: $auth_type" >&2; exit 78 ;;
esac

if [ "$command_name" = "clone" ]; then
  # A sparse clone skips file contents outside its folders (servers without
  # partial clone support ignore the filter and send them anyway).
  sparse_options=
  [ -z "$sparse_paths" ] || sparse_options="--filter=blob:none --sparse"
  if [ -n "$branch" ]; then
    git -c credential.helper= clone $clone_depth $sparse_options --branch "$branch" -- "$repository_url" "$target"
  else
    git -c credential.helper= clone $clone_depth $sparse_options -- "$repository_url" "$target"
  fi
  if [ -n "$sparse_paths" ]; then
    # Validated above: plain relative names, safe to split on spaces.
    # shellcheck disable=SC2086
    git -C "$target" -c credential.helper= sparse-checkout set --cone -- $sparse_paths
  fi
elif [ "$command_name" = "heads" ]; then
  # Branch names only (an empty repository prints nothing), for callers that
  # must tell an empty remote from one that already has history.
  git -c credential.helper= ls-remote --heads "$repository_url" | sed -n 's#^[0-9a-f]*[[:space:]]*refs/heads/##p'
elif [ "$command_name" = "push" ]; then
  git -C "$worktree" -c credential.helper= push "$repository_url" "$@"
else
  if [ -n "$branch" ]; then
    git -c credential.helper= ls-remote --exit-code --refs "$repository_url" "$branch" >/dev/null
  else
    # HEAD is a pseudo-ref and is intentionally omitted by `--refs`. Keep the
    # explicit HEAD pattern, but allow pseudo-refs so a repository connection
    # test works without requiring the caller to know its default branch.
    git -c credential.helper= ls-remote --exit-code "$repository_url" HEAD >/dev/null
  fi
fi
