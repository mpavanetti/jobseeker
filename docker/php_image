FROM php:8.3-fpm-alpine

RUN set -eux; \
	apk add --no-cache libzip libpq git openssh-client-default openssh-keygen; \
	apk add --no-cache --virtual .build-deps $PHPIZE_DEPS libzip-dev postgresql-dev; \
	docker-php-ext-configure zip; \
	docker-php-ext-install mysqli pdo_mysql pdo_pgsql zip; \
	apk del .build-deps

COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/
COPY docker/php/security.ini /usr/local/etc/php/conf.d/
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/zz-jobseeker.conf

WORKDIR /var/www/html

RUN addgroup --gid 1000 mygroup
RUN adduser --system --no-create-home --disabled-password --uid 1000 --ingroup mygroup myuser

RUN mkdir -p /php/data /php/repository \
	&& chown -R myuser:mygroup /php /var/www \
	&& chmod -R 775 /php

# Compose bind mounts these paths for live development. Baking the application
# into the image as well makes the same image usable by Kubernetes and other
# immutable-container runtimes.
COPY --chown=myuser:mygroup application /var/www/html/application
COPY --chown=myuser:mygroup assets /var/www/html/assets
COPY --chown=myuser:mygroup system /var/www/html/system
COPY --chown=myuser:mygroup .project /var/www/html/.project
COPY --chown=myuser:mygroup index.php /var/www/html/index.php

USER myuser

# Personal Git accounts clone OpenVSCode workspaces through the same helper as
# the workers, which keeps secrets out of URLs, arguments and logs.
COPY --chmod=0755 docker/jenkins/jobseeker-git /usr/local/bin/jobseeker-git

# Compose starts this as root; the script drops to the checkout owner's uid.
COPY --chmod=0755 docker/jobseeker-host-user.sh /usr/local/bin/jobseeker-host-user
ENV JOBSEEKER_RUNTIME_USER=myuser \
	JOBSEEKER_OWNER_REFERENCE=/php/repository
ENTRYPOINT ["/usr/local/bin/jobseeker-host-user", "docker-php-entrypoint"]
CMD ["php-fpm"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD php-fpm -t || exit 1
