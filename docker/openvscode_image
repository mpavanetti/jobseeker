ARG OPENVSCODE_VERSION=1.105.1
FROM gitpod/openvscode-server:${OPENVSCODE_VERSION}

COPY --from=ghcr.io/astral-sh/uv:0.12.6 /uv /uvx /usr/local/bin/
COPY --chmod=0755 docker/openvscode-idle-watch.sh /usr/local/bin/jobseeker-openvscode

USER root

ARG JOBSEEKER_PYTHON_VERSION=3.13.7
ARG POETRY_VERSION=2.4.1
ARG RUFF_VERSION=0.16.4
ARG MYPY_VERSION=2.3.1

ENV UV_PYTHON_INSTALL_DIR=/opt/jobseeker-python

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		build-essential \
		git \
		openssh-client \
		pkg-config \
		python3 \
		python3-pip \
		python3-venv; \
	uv python install "$JOBSEEKER_PYTHON_VERSION"; \
	JOBSEEKER_PYTHON_313="$(uv python find "$JOBSEEKER_PYTHON_VERSION")"; \
	ln -sf "$JOBSEEKER_PYTHON_313" /usr/local/bin/python3.13; \
	ln -sf /usr/local/bin/python3.13 /usr/local/bin/python3; \
	ln -sf /usr/local/bin/python3.13 /usr/local/bin/python; \
	"$JOBSEEKER_PYTHON_313" -m venv /opt/jobseeker-python-tools; \
	/opt/jobseeker-python-tools/bin/python -m pip install --no-cache-dir \
		"poetry==$POETRY_VERSION" \
		"ruff==$RUFF_VERSION" \
		"mypy==$MYPY_VERSION"; \
	ln -sf /usr/local/bin/python3.13 /usr/local/bin/jobseeker-python; \
	ln -sf /opt/jobseeker-python-tools/bin/ruff /usr/local/bin/ruff; \
	ln -sf /opt/jobseeker-python-tools/bin/mypy /usr/local/bin/mypy; \
	ln -sf /opt/jobseeker-python-tools/bin/poetry /usr/local/bin/poetry; \
	mkdir -p /home/workspace/.cache /home/workspace/.local /home/workspace/.openvscode-server/python; \
	chown -R openvscode-server:openvscode-server /home/workspace/.cache /home/workspace/.local /home/workspace/.openvscode-server; \
	rm -rf /var/lib/apt/lists/*

USER openvscode-server

RUN set -eux; \
	mkdir -p /home/workspace/.openvscode-server/extensions /home/workspace/.openvscode-server/data; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension ms-python.python@2026.4.0; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension ms-python.debugpy@2026.6.0; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension charliermarsh.ruff@2026.74.0; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension ms-python.mypy-type-checker@2026.6.0; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension detachhead.basedpyright@1.39.10; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--uninstall-extension ms-python.vscode-python-envs
