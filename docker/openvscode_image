FROM gitpod/openvscode-server:latest

USER root

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		git \
		python3 \
		python3-pip \
		python3-venv; \
	python3 -m venv /opt/jobseeker-python-tools; \
	/opt/jobseeker-python-tools/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel; \
	/opt/jobseeker-python-tools/bin/python -m pip install --no-cache-dir poetry ruff mypy; \
	ln -sf /opt/jobseeker-python-tools/bin/ruff /usr/local/bin/ruff; \
	ln -sf /opt/jobseeker-python-tools/bin/mypy /usr/local/bin/mypy; \
	ln -sf /opt/jobseeker-python-tools/bin/poetry /usr/local/bin/poetry; \
	rm -rf /var/lib/apt/lists/*

USER openvscode-server

RUN set -eux; \
	mkdir -p /home/workspace/.openvscode-server/extensions /home/workspace/.openvscode-server/data; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension ms-python.python; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension charliermarsh.ruff; \
	"${OPENVSCODE_SERVER_ROOT}/bin/openvscode-server" \
		--extensions-dir /home/workspace/.openvscode-server/extensions \
		--user-data-dir /home/workspace/.openvscode-server/data \
		--install-extension ms-python.mypy-type-checker
